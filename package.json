{
  "name": "baseball-manager-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx scripts/balance.ts",
    "e2e": "playwright test",
    "pace": "tsx scripts/pace.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-diamond \"tsx scripts/test-rules.ts\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-diamond",
    "e2e:sync": "firebase emulators:exec --only firestore,auth --project demo-diamond \"playwright test -c playwright.sync.config.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^20.19.43",
    "firebase-tools": "15.35.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  },
  "dependencies": {
    "firebase": "12.19.0"
  }
}
